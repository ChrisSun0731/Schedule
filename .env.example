# 複製為 .env.local 並填入 Firebase 專案設定（Firebase Console → 專案設定 → 一般 → 您的應用程式）
# GitHub Pages 部署時，請將相同名稱的變數設為 Repository secrets（見 README）。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Functions 區域（email provider = function 時使用）
VITE_FIREBASE_FUNCTIONS_REGION=asia-east1

# 本機開發：true 時連線至 Firebase Emulator（auth:9099, firestore:8080, functions:5001）
VITE_USE_EMULATORS=false

# 郵件寄送方式：mock | firestore | function | emailjs
#   mock      模擬寄送（不會真的寄信，用於測試）
#   firestore 寫入 `mail` 集合，由 Firebase「Trigger Email」擴充功能透過 SMTP（AWS SES / Resend SMTP）寄送
#   function  呼叫 Cloud Function `sendEmail`（functions/，支援 Resend API 或 AWS SES）
#   emailjs   直接由瀏覽器呼叫 EmailJS
VITE_EMAIL_PROVIDER=mock

# EmailJS（VITE_EMAIL_PROVIDER=emailjs 時必填）。範本需包含 {{to_email}}、{{to_name}}、{{subject}}、{{{html_body}}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
