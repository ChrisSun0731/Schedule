rules_version = '2';

// Nursing shift scheduling – Firestore security rules
//
// Roles (users/{email}.role):
//   developer   全部權限：病房/人員/角色管理、系統設定、所有病房的排班與審核
//   head_nurse  僅限 users/{email}.wardIds 所列的病房：排班、編輯、發布並通知、
//               審核換班/請假、調整該病房的人力需求
//   nurse       檢視已發布班表、提出/回覆換班、為自己的病房申請請假
//
// User documents are keyed by the lower-case Google account e-mail.
// Schedules, swap requests and leave requests carry the `wardId` they belong to.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Bootstrap: these Google accounts may create their own `developer`
    // profile on first sign-in. Replace with your own e-mail before deploying.
    // ------------------------------------------------------------------
    function bootstrapDevelopers() {
      return ['admin@example.com'];
    }

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function userPath(email) {
      return /databases/$(database)/documents/users/$(email);
    }

    function profile() {
      return get(userPath(myEmail())).data;
    }

    function registered() {
      return signedIn() && exists(userPath(myEmail())) && profile().active == true;
    }

    function hasRole(roles) {
      return registered() && profile().role in roles;
    }

    function isDeveloper() {
      return hasRole(['developer']);
    }

    function isManager() {
      return hasRole(['developer', 'head_nurse']);
    }

    function myWardIds() {
      return profile().get('wardIds', []);
    }

    // Developers manage every ward; a head nurse only the wards listed in their profile.
    function managesWard(w) {
      return isDeveloper() || (hasRole(['head_nurse']) && w in myWardIds());
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function schedulePath(id) {
      return /databases/$(database)/documents/schedules/$(id);
    }

    function swapPath(id) {
      return /databases/$(database)/documents/swap_requests/$(id);
    }

    function wardPath(id) {
      return /databases/$(database)/documents/wards/$(id);
    }

    // ------------------------------------------------------------------
    // users
    // ------------------------------------------------------------------
    function validUser(u, email) {
      return u.id == email
        && u.email == email
        && u.role in ['developer', 'head_nurse', 'nurse']
        && u.get('wardIds', []) is list
        && u.get('wardIds', []).size() <= 50
        && u.level in ['N0', 'N1', 'N2', 'N3']
        && u.displayName is string && u.displayName.size() > 0
        && u.employeeId is string
        && u.allowedShifts is list && u.allowedShifts.hasOnly(['D', 'E', 'N'])
        && u.schedulable is bool
        && u.active is bool;
    }

    match /users/{email} {
      // Everyone may read their own profile (so the app can tell "not registered" from "disabled").
      allow read: if registered() || (signedIn() && email == myEmail());

      allow create: if (isDeveloper() && validUser(request.resource.data, email))
        || (signedIn()
            && email == myEmail()
            && myEmail() in bootstrapDevelopers()
            && request.resource.data.role == 'developer'
            && request.resource.data.active == true
            && validUser(request.resource.data, email));

      allow update: if (isDeveloper()
            && validUser(request.resource.data, email)
            // a developer cannot demote or deactivate themselves (avoids lock-out)
            && (email != myEmail()
                || (request.resource.data.role == 'developer' && request.resource.data.active == true)))
        // every user may stamp their own login metadata
        || (signedIn()
            && email == myEmail()
            && changedOnly(['uid', 'photoURL', 'lastLoginAt'])
            && request.resource.data.uid == request.auth.uid);

      allow delete: if isDeveloper() && email != myEmail();
    }

    // ------------------------------------------------------------------
    // settings/app
    // ------------------------------------------------------------------
    match /settings/{id} {
      allow read: if registered();
      allow write: if isDeveloper();
    }

    // ------------------------------------------------------------------
    // wards/{wardId} – 病房單位 and their staffing rules
    // ------------------------------------------------------------------
    function validDemand(d) {
      return d is map && d.D is number && d.E is number && d.N is number
        && d.D >= 0 && d.E >= 0 && d.N >= 0;
    }

    function validWard(w, id) {
      return w.id == id
        && w.name is string && w.name.size() > 0 && w.name.size() <= 40
        && validDemand(w.weekdayDemand)
        && validDemand(w.weekendDemand)
        && w.minSeniorPerShift is number && w.minSeniorPerShift >= 0
        && w.preferredSeniorPerShift is number && w.preferredSeniorPerShift >= 0
        && w.requireHeadApproval is bool;
    }

    match /wards/{wid} {
      allow read: if registered();
      allow create: if isDeveloper() && validWard(request.resource.data, wid);
      allow delete: if isDeveloper();
      // Head nurses tune staffing and the swap policy of their own wards; renaming is for developers.
      allow update: if validWard(request.resource.data, wid)
        && (isDeveloper()
            || (managesWard(wid)
                && changedOnly(['weekdayDemand', 'weekendDemand', 'minSeniorPerShift', 'preferredSeniorPerShift',
                                'requireHeadApproval', 'updatedAt', 'updatedBy'])));
    }

    // ------------------------------------------------------------------
    // schedules/{wardId}_{startDate}
    // ------------------------------------------------------------------
    function validSchedule(s, id) {
      return s.wardId is string
        && id == s.wardId + '_' + s.startDate
        && s.id == id
        && exists(wardPath(s.wardId))
        && s.status in ['draft', 'published']
        && s.nurseOrder is list
        && s.nurses is map
        && s.assignments is map
        && s.locks is map
        && s.holidays is list;
    }

    // Only work shifts and plain days off may be swapped – never any kind of leave or 預假.
    function notLeave(code) {
      return code in ['D', 'E', 'N', 'OFF'];
    }

    // Row `n` equals row `o` everywhere except at indexes lo and hi.
    // (Empty slices raise "index out of bound" in the rules runtime, hence the guards.)
    function rowKept(o, n, lo, hi) {
      return n.size() == o.size()
        && (lo == 0 || n[0:lo] == o[0:lo])
        && (hi <= lo + 1 || n[lo + 1:hi] == o[lo + 1:hi])
        && (hi >= n.size() - 1 || n[hi + 1:n.size()] == o[hi + 1:o.size()]);
    }

    // `a` (after) is `b` (before) with the requester's and target's cells exchanged
    // on the requester's day and the target's day – nothing else changed.
    function cellsSwapped(b, a, s) {
      let A = s.requesterId;
      let B = s.targetId;
      let d1 = s.requesterDay;
      let d2 = s.targetDay;
      let lo = d1 < d2 ? d1 : d2;
      let hi = d1 < d2 ? d2 : d1;
      return A != B
        && a.diff(b).affectedKeys().hasOnly([A, B])
        && b[A][d1] == s.requesterShift
        && b[B][d2] == s.targetShift
        && notLeave(b[A][d1]) && notLeave(b[B][d1])
        && notLeave(b[A][d2]) && notLeave(b[B][d2])
        && a[A][d1] == b[B][d1] && a[B][d1] == b[A][d1]
        && a[A][d2] == b[B][d2] && a[B][d2] == b[A][d2]
        && rowKept(b[A], a[A], lo, hi)
        && rowKept(b[B], a[B], lo, hi);
    }

    // A staff nurse applying a swap they were asked to approve. Must be written in the
    // same transaction that moves the swap request from pending_target to approved.
    function swapApplication(sid) {
      let before = resource.data;
      let after = request.resource.data;
      let swapId = after.lastSwapId;
      let s = get(swapPath(swapId)).data;
      return registered()
        && before.status == 'published'
        && after.diff(before).affectedKeys().hasOnly(['assignments', 'lastSwapId', 'updatedAt', 'updatedBy'])
        && after.updatedBy == myEmail()
        && s.scheduleId == sid
        && s.targetId == myEmail()
        && s.status == 'pending_target'
        && getAfter(swapPath(swapId)).data.status == 'approved'
        && cellsSwapped(before.assignments, after.assignments, s);
    }

    match /schedules/{sid} {
      allow read: if managesWard(resource.data.wardId) || (registered() && resource.data.status == 'published');
      allow create: if managesWard(request.resource.data.wardId) && validSchedule(request.resource.data, sid);
      allow update: if (managesWard(resource.data.wardId)
            && request.resource.data.wardId == resource.data.wardId
            && validSchedule(request.resource.data, sid))
        || swapApplication(sid);
      // Developers may also remove schedules from before wards existed (no wardId) after migrating them.
      allow delete: if isDeveloper() || (managesWard(resource.data.wardId) && resource.data.status == 'draft');
    }

    // ------------------------------------------------------------------
    // swap_requests
    // ------------------------------------------------------------------
    function validSwapCreate(s) {
      let sched = get(schedulePath(s.scheduleId)).data;
      return s.status == 'pending_target'
        && s.requesterId != s.targetId
        && s.requesterShift in ['D', 'E', 'N']
        && s.targetShift in ['D', 'E', 'N']
        && s.requesterDay is int && s.requesterDay >= 0 && s.requesterDay < 28
        && s.targetDay is int && s.targetDay >= 0 && s.targetDay < 28
        && s.targetEmail is string
        && s.warnings is list
        && sched.status == 'published'
        && s.wardId == sched.wardId;
    }

    function headApprovalRequired() {
      return get(wardPath(resource.data.wardId)).data.get('requireHeadApproval', false) == true;
    }

    function targetResponseValid(id) {
      let next = request.resource.data.status;
      return next == 'rejected'
        || next == 'pending_head'
        || (next == 'approved'
            && !headApprovalRequired()
            && getAfter(schedulePath(resource.data.scheduleId)).data.lastSwapId == id);
    }

    function isParticipant() {
      return resource.data.requesterId == myEmail() || resource.data.targetId == myEmail();
    }

    match /swap_requests/{id} {
      allow read: if managesWard(resource.data.wardId) || (registered() && isParticipant());

      allow create: if registered()
        && validSwapCreate(request.resource.data)
        && (request.resource.data.requesterId == myEmail() || managesWard(request.resource.data.wardId));

      allow update: if isDeveloper()
        || (managesWard(resource.data.wardId) && request.resource.data.wardId == resource.data.wardId)
        // requester withdraws
        || (registered()
            && resource.data.requesterId == myEmail()
            && resource.data.status in ['pending_target', 'pending_head']
            && request.resource.data.status == 'cancelled'
            && changedOnly(['status', 'updatedAt']))
        // target approves / rejects / escalates to head nurse
        || (registered()
            && resource.data.targetId == myEmail()
            && resource.data.status == 'pending_target'
            && changedOnly(['status', 'warnings', 'responseNote', 'respondedAt', 'updatedAt'])
            && targetResponseValid(id))
        // participants record e-mail delivery status
        || (registered() && isParticipant() && changedOnly(['emailStatus', 'updatedAt']));

      allow delete: if isDeveloper();
    }

    // ------------------------------------------------------------------
    // leave_requests
    // ------------------------------------------------------------------
    // Leave types: keep in sync with LEAVE_TYPES in src/types/schedule.ts.
    function validLeave(l) {
      return l.wardId is string
        && l.type in ['AL', 'OL', 'REQ', 'SL', 'PL', 'MNL', 'CO', 'BL', 'WL', 'MAT', 'PAT', 'IL']
        && l.startDate is string
        && l.endDate is string
        && l.startDate <= l.endDate
        && l.status in ['pending', 'approved', 'rejected', 'cancelled'];
    }

    // The leave is filed under one of the nurse's own wards.
    function nurseInWard(l) {
      return l.wardId in get(userPath(l.nurseId)).data.get('wardIds', []);
    }

    match /leave_requests/{id} {
      allow read: if managesWard(resource.data.wardId) || (registered() && resource.data.nurseId == myEmail());
      allow create: if validLeave(request.resource.data)
        && (isDeveloper()
            || (managesWard(request.resource.data.wardId) && nurseInWard(request.resource.data))
            || (registered()
                && request.resource.data.nurseId == myEmail()
                && request.resource.data.status == 'pending'
                && nurseInWard(request.resource.data)));
      allow update: if (validLeave(request.resource.data)
            && (isDeveloper()
                || (managesWard(resource.data.wardId) && request.resource.data.wardId == resource.data.wardId)))
        || (registered()
            && resource.data.nurseId == myEmail()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && changedOnly(['status', 'updatedAt']));
      allow delete: if managesWard(resource.data.wardId);
    }

    // ------------------------------------------------------------------
    // email_logs – delivery audit trail
    // ------------------------------------------------------------------
    match /email_logs/{id} {
      allow read: if isManager() || (registered() && resource.data.sentBy == myEmail());
      allow create: if registered()
        && request.resource.data.sentBy == myEmail()
        && (isManager() || request.resource.data.type in ['swap_request', 'swap_result']);
      allow update: if registered()
        && resource.data.sentBy == myEmail()
        && request.resource.data.sentBy == myEmail()
        && request.resource.data.type == resource.data.type;
      allow delete: if isDeveloper();
    }

    // ------------------------------------------------------------------
    // mail – queue for the Firebase "Trigger Email" extension (SMTP: AWS SES / Resend)
    // The extension updates `delivery` with admin privileges.
    // ------------------------------------------------------------------
    function swapMailAllowed(m) {
      let s = get(swapPath(m.swapId)).data;
      return (s.requesterId == myEmail() && m.to == s.targetEmail)
        || (s.targetId == myEmail() && m.to == s.requesterEmail);
    }

    match /mail/{id} {
      allow read: if registered() && resource.data.createdBy == myEmail();
      allow create: if registered()
        && request.resource.data.createdBy == myEmail()
        && (isManager() || swapMailAllowed(request.resource.data));
    }
  }
}
